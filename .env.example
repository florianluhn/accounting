# ==============================================
# INSTANCE CONFIGURATION
# ==============================================
# Change these values for each instance running on the same device
# Example: For "Company A", use APP_NAME="Company A Accounting"

# Application Name (displayed in UI and browser title)
APP_NAME=Accounting App
APP_SHORT_NAME=Accounting
APP_DESCRIPTION=Personal finance accounting with double-entry bookkeeping

# ==============================================
# BACKEND SERVER CONFIGURATION
# ==============================================
# Backend API server settings
BACKEND_PORT=3000
# Keep the API on loopback. Browsers and the assistant reach it through the SvelteKit proxy.
BACKEND_HOST=127.0.0.1

# ==============================================
# FRONTEND SERVER CONFIGURATION
# ==============================================
# Frontend web server settings
FRONTEND_PORT=5173
FRONTEND_HOST=0.0.0.0

# Leave empty. The browser must not call port 3000 directly.
API_URL=

# Public origin of this site: scheme, host, and port, with no path.
# SvelteKit rejects multipart attachment uploads (PDF/images on journal entries)
# when this does not match the browser Origin header. Do not copy API_URL here.
# Production behind Cloudflare Tunnel:
#   ORIGIN=https://accounting.florianluhn.com
# Leave empty to infer https://<Host> from the incoming request. Set it when the
# tunnel does not forward that public host and the browser shows
# "Cross-site POST form submissions are forbidden".
ORIGIN=

# Request body limit for the SvelteKit Node server. A byte count or a K/M/G
# suffix (12M, not 12MB). Must be larger than MAX_FILE_SIZE_MB because a
# multipart body includes framing around the file. Leave unset to use
# (MAX_FILE_SIZE_MB + 2) megabytes, which is 12M at the default 10MB file limit.
# BODY_SIZE_LIMIT=12M

# Comma-separated browser origins allowed to call the API directly. The UI uses the proxy, so this is optional.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when the site is served over HTTPS (Cloudflare Tunnel).
COOKIE_SECURE=false

# Directory that may contain availability.json. Defaults to the home directory.
# AVAILABILITY_ROOT=/home/florian/villaluhna

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Path to SQLite database file
DATABASE_PATH=./data/accounting.db

# ==============================================
# FILE STORAGE CONFIGURATION
# ==============================================
# Path to store uploaded attachments
ATTACHMENTS_PATH=./data/attachments

# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=10

# Maximum total storage (in GB)
MAX_STORAGE_GB=40

# ==============================================
# PM2 CONFIGURATION
# ==============================================
# PM2 process names (must be unique per instance)
PM2_BACKEND_NAME=accounting-backend
PM2_FRONTEND_NAME=accounting-frontend

# Log file paths
LOG_DIR=./logs

# ==============================================
# BACKUP CONFIGURATION
# ==============================================
# Enable/disable automatic backups
BACKUP_ENABLED=true

# Backup schedule (cron format: minute hour day month weekday)
# Default: "0 2 * * *" = Daily at 2:00 AM
BACKUP_CRON=0 2 * * *

# Synology NAS Configuration
# BACKUP_NAS_SHARE: The shared folder name (e.g., "Documents", "homes", "backup")
# BACKUP_NAS_FOLDER: Subdirectory path within the share (e.g., "path/to/backups")
# Example: SHARE=Documents, FOLDER=Finanzen/Accounting → //NAS_HOST/Documents/Finanzen/Accounting/
BACKUP_NAS_HOST=192.168.1.30
BACKUP_NAS_SHARE=Documents
BACKUP_NAS_FOLDER=Finanzen/Finanzplanung/Pi_Backup/Accounting
BACKUP_NAS_USERNAME=accounting-backup
BACKUP_NAS_PASSWORD=

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Local backup directory (before transfer to NAS)
BACKUP_LOCAL_DIR=./backups

# ==============================================
# ENVIRONMENT
# ==============================================
NODE_ENV=development
